# Upstash Redis — added automatically when you connect Upstash Redis to the
# project in Vercel (Storage → Upstash → Redis). Copy from the Vercel dashboard
# into .env.local to use the real database while developing locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Game admin password (games + lucky draw). Defaults to "games123" if empty.
ADMIN_PASSCODE=

# Recommended: signs guest login cookies. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Registration (front desk) password. Defaults to "registration123" if empty.
REGISTRATION_PASSCODE=
