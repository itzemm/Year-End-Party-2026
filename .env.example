# Upstash Redis — added automatically when you connect Upstash Redis to the
# project in Vercel (Storage → Upstash → Redis). Copy from the Vercel dashboard
# into .env.local to use the real database while developing locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: organisers' passcode for the Registration and Lucky Draw tabs.
# Leave empty to keep them open. Guests scanning QR codes never need it.
ADMIN_PASSCODE=
